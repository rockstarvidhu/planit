# Local examples only. Real credentials belong in an ignored .env or deployment secret store.
GOOGLE_API_KEY=
GEMINI_API_KEY=
# Set to an available model verified in your Google project before enabling AI.
GEMINI_MODEL=
ALLOWED_ORIGINS=http://localhost:3000,https://planit-v1.vercel.app
