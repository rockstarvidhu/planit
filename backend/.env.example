# Local examples only. Real credentials belong in an ignored .env or deployment secret store.
GOOGLE_API_KEY=
GEMINI_API_KEY=
# Set to an available model verified in your Google project before enabling AI.
GEMINI_MODEL=
ALLOWED_ORIGINS=http://localhost:3000,https://planit-v1.vercel.app
# Empty means no trusted proxies. Exact IP addresses only, after ingress verification.
TRUSTED_PROXY_IPS=
PORT=5000
# New Places adapter is off by default. Fixture mode is unavailable in production.
ROVE_PLACES_MODE=disabled
ROVE_PLACES_LIVE_ENABLED=false
# Current opening hours add Enterprise field billing. Enable only after review.
ROVE_PLACES_ENTERPRISE_FIELDS_ENABLED=false
