{
  "expo": {
    "name": "Rove",
    "slug": "rove-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "rove",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F3EB",
          "image": "./design-handoff/ROVE_Complete_First_Launch_Assets_v2/splash/native/native-wordmark-light-1024.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#080908",
            "image": "./design-handoff/ROVE_Complete_First_Launch_Assets_v2/splash/native/native-wordmark-dark-1024.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
